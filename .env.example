# Server Configuration
HOST=0.0.0.0
PORT=8765
DEBUG=false

# STT Providers
DEEPGRAM_API_KEY=
DEFAULT_STT_PROVIDER=fallback

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=fallback

# Ollama / Local LLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# TTS Providers
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
DEFAULT_TTS_PROVIDER=native

# Voice & VAD Parameters
VAD_THRESHOLD=0.5
VAD_SPEECH_PAD_MS=64
VAD_SILENCE_TIMEOUT_MS=150
DEFAULT_VOICE_ID=en_default
